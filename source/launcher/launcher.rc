#include "resource.h"
#include <winver.h>

IDI_APP_ICON ICON "assets/app-icon.ico"

#define BBVR_STR2(x) #x
#define BBVR_STR(x) BBVR_STR2(x)

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    BBVR_VERSION_MAJOR, BBVR_VERSION_MINOR, BBVR_VERSION_PATCH, 0
 PRODUCTVERSION BBVR_VERSION_MAJOR, BBVR_VERSION_MINOR, BBVR_VERSION_PATCH, 0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "BB-VR contributors\0"
            VALUE "FileDescription", "Bldbrne-VR launcher\0"
            VALUE "FileVersion", BBVR_STR(BBVR_VERSION_MAJOR) "." BBVR_STR(BBVR_VERSION_MINOR) "." BBVR_STR(BBVR_VERSION_PATCH) ".0\0"
            VALUE "InternalName", "Bldbrne-VR\0"
            VALUE "LegalCopyright", "Copyright 2026 BB-VR contributors. Licensed AGPL-3.0-or-later.\0"
            VALUE "Comments", "https://github.com/bldbrne-vr/bldbrne-vr. Redistribution is permitted only under the AGPL-3.0-or-later, with these notices and the complete corresponding source.\0"
            VALUE "OriginalFilename", "Bldbrne-VR.exe\0"
            VALUE "ProductName", "Bldbrne-VR\0"
            VALUE "ProductVersion", BBVR_STR(BBVR_VERSION_MAJOR) "." BBVR_STR(BBVR_VERSION_MINOR) "." BBVR_STR(BBVR_VERSION_PATCH) ".0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

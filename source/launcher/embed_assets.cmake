# Writes the launcher's images into a C++ source as byte arrays (embedded_assets.h).
# Run as: cmake -DOUT=<file.cpp> -DROOT=<launcher dir> -DASSETS="<id>=<path>,..." -P embed_assets.cmake
#
# They used to be RCDATA resources. Velopack copies every resource of the launcher into the
# install root's stub (Bldbrne-VR.exe), so the stub carried 1.4 MB of images it never reads, and
# antivirus models flag a small program with a large unused blob as a dropper (2026-11-28: 31 of
# 63 engines on VirusTotal, Microsoft's Program:Win32/Wacapew.C!ml). Compiled-in arrays stay in
# the launcher's own code; the stub gets only the icon.
set(body "// Generated by embed_assets.cmake from the launcher's assets. Do not edit.\n#include \"embedded_assets.h\"\n\nnamespace {\n")
set(cases "")
string(REPLACE "," ";" ASSETS "${ASSETS}")
foreach(entry IN LISTS ASSETS)
    string(REPLACE "=" ";" parts "${entry}")
    list(GET parts 0 id)
    list(GET parts 1 path)
    file(READ "${ROOT}/${path}" hex HEX)
    string(LENGTH "${hex}" length)
    if(length EQUAL 0)
        message(FATAL_ERROR "embed_assets: ${path} is empty")
    endif()
    math(EXPR size "${length} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(APPEND body "// ${path}\nalignas(16) const unsigned char asset_${id}[${size}] = {${bytes}};\n")
    string(APPEND cases "    case ${id}: return {asset_${id}, sizeof(asset_${id})};\n")
endforeach()
string(APPEND body "} // namespace\n\nnamespace Launcher {\nEmbeddedAsset FindEmbeddedAsset(int id) {\n    switch (id) {\n${cases}    default: return {};\n    }\n}\n} // namespace Launcher\n")
file(WRITE "${OUT}.tmp" "${body}")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")

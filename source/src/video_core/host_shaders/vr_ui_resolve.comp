shared uint s_l[1024];
shared uint s_r[1024];

void main() {
    const uint i = gl_LocalInvocationIndex;
    const int dyn = DynamicCut();
    const ivec4 dr = dyn >= 0 ? pc.cut[dyn] : ivec4(0);
    const uint rows = uint(clamp(dr.w - dr.y, 0, 1024));
    const uint words = MaskWords(dr);
    const uint min_width = SplitMinWidth();
    const uint gap = SplitGap();
    // Per row: the union of its runs at least min_width wide (mask bits, gaps <= gap bridged).
    for (uint r = i; r < rows; r += 256u) {
        uint lo = 0xFFFFFFFFu;
        uint hi = 0u;
        bool open = false;
        uint start = 0u;
        uint last = 0u;
        for (uint wi = 0u; wi < words; ++wi) {
            uint bits = split.mask[r * words + wi];
            while (bits != 0u) {
                const uint x = wi * 32u + uint(findLSB(bits));
                uint end = x;
                if (bits == 0xFFFFFFFFu) {
                    end = wi * 32u + 31u; // a full word in one step
                    bits = 0u;
                } else {
                    bits &= bits - 1u;
                }
                if (open && x <= last + gap + 1u) {
                    last = end;
                } else {
                    if (open && last - start + 1u >= min_width) {
                        lo = min(lo, start);
                        hi = max(hi, last);
                    }
                    open = true;
                    start = x;
                    last = end;
                }
            }
        }
        if (open && last - start + 1u >= min_width) {
            lo = min(lo, start);
            hi = max(hi, last);
        }
        s_l[r] = lo;
        s_r[r] = hi;
    }
    barrier();
    // Dilated over the neighbouring rows (band px), the UI left out of it counted, the mask
    // cleared for the next frame (the same rows as above: no barrier needed).
    const int dilate = int(SplitDilate());
    const uint margin = SplitMargin();
    uint found = 0u;
    uint left_out = 0u;
    uint right = 0u;
    for (uint r = i; r < 1024u; r += 256u) {
        uint lo = 0xFFFFFFFFu;
        uint hi = 0u;
        if (r < rows) {
            const int a = max(int(r) - dilate, 0);
            const int b = min(int(r) + dilate, int(rows) - 1);
            for (int j = a; j <= b; ++j) {
                if (s_l[j] <= s_r[j]) {
                    lo = min(lo, s_l[j]);
                    hi = max(hi, s_r[j]);
                }
            }
            if (s_l[r] <= s_r[r]) {
                ++found;
            }
            // Mask bits outside [lo - margin, hi + margin] stay on the rest quad.
            const int in0 = lo <= hi ? int(lo) - int(margin) : 1;
            const int in1 = lo <= hi ? int(hi) + int(margin) : 0;
            for (uint wi = 0u; wi < words; ++wi) {
                const uint bits = split.mask[r * words + wi];
                if (bits == 0u) {
                    continue;
                }
                split.mask[r * words + wi] = 0u;
                const int w0 = int(wi * 32u);
                const int a0 = clamp(in0 - w0, 0, 32);
                const int a1 = clamp(in1 - w0 + 1, 0, 32);
                uint inside = 0u;
                if (a1 > a0) {
                    const uint upto = a1 >= 32 ? 0xFFFFFFFFu : (1u << uint(a1)) - 1u;
                    const uint from = a0 >= 32 ? 0u : ~((1u << uint(a0)) - 1u);
                    inside = upto & from;
                }
                left_out += uint(bitCount(bits & ~inside));
            }
        }
        const bool any_hud = lo <= hi;
        if (any_hud) {
            right = max(right, uint(dr.x) + hi + 1u);
        }
        split.row_lr[2u * r] = any_hud ? uint(dr.x) + lo : 1u;
        split.row_lr[2u * r + 1u] = any_hud ? uint(dr.x) + hi : 0u;
    }
    if (found != 0u) {
        atomicAdd(stats.words[W_SPLIT_ROWS], found);
    }
    if (left_out != 0u) {
        atomicAdd(stats.words[W_SPLIT_OUT], left_out);
    }
    if (right != 0u) {
        atomicMax(stats.words[W_SPLIT_RIGHT], right);
    }
}

#elif MODE == 5

void main() {
    const int dyn = DynamicCut();
    const ivec4 dr = dyn >= 0 ? pc.cut[dyn] : ivec4(0);
    const ivec2 p = dr.xy + ivec2(gl_GlobalInvocationID.xy);
    if (dyn < 0 || p.x >= dr.z || p.y >= dr.w || p.x >= pc.band.z || p.y >= pc.band.w) {
        return;
    }
    const uint row = uint(p.y - dr.y);
    bool hud = false;
    if (row < 1024u) {
        const int lo = int(split.row_lr[2u * row]);
        const int hi = int(split.row_lr[2u * row + 1u]);
        const int margin = int(SplitMargin());
        hud = lo <= hi && p.x >= lo - margin && p.x <= hi + margin;
    }
    // The action prompt's stage bounds (491..1416, 868..946), with room for its
    // backing and fade animation. A faint/narrow first frame must never land on the
    // much larger world-aligned rest quad before the width classifier recognizes it.
    // Only the active prompt's region is reserved; enemy tags elsewhere still use
    // the existing content classifier. This is routing only: no colour/alpha filter.
    const float k = float(pc.band.z) / 1920.0;
    if ((pc.flags & FLAG_ACTION_PROMPT) != 0u &&
        p.x >= int(floor(460.0 * k)) && p.x < int(ceil(1460.0 * k)) &&
        p.y >= int(floor(844.0 * k)) && p.y < int(ceil(972.0 * k))) {
        hud = true;
    }
    // The game exposes the item-get queue before the confirmation fades in. Keep
    // that lower-HUD popup on its final layer, even before its pixels form a wide row.
    if ((pc.flags & (FLAG_ITEM_PICKUP | FLAG_DIALOGUE)) != 0u) {
        hud = true; // this invocation is already confined to the lower dynamic cut
    }
    // An area name's corner: whole on its piece (its keyed words' rows are no wide runs, its
    // backing's faint edges never on the rest quad).
    if (InAreaName(p)) {
        hud = true;
    }
    if (hud) {
        imageStore(atlas_img, ivec2(p.x, p.y + pc.band.w), vec4(0.0)); // off the rest quad
    } else {
        imageStore(atlas_img, p, vec4(0.0)); // off the HUD band
    }
}

#elif MODE == 6

void main() {
    const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if ((pc.flags & FLAG_FULL_MENU) == 0u || stats.words[W_REST] != 0u || p.x >= pc.band.z ||
        p.y >= pc.band.w) {
        return; // the menu is there
    }
    if (p == ivec2(0)) {
        stats.words[W_MENU_GONE] = 1u;
    }
    for (uint c = 0u; c < pc.cut_count && c < 4u; ++c) {
        const ivec4 r = pc.cut[c];
        if (((pc.flags >> (STATUS_SHIFT + c)) & 1u) != 0u && p.x >= r.x && p.y >= r.y &&
            p.x < r.z && p.y < r.w) {
            imageStore(atlas_img, p, vec4(0.0));
            return;
        }
    }
}

#elif MODE == 7

shared uint s_count[2];
shared uint s_foot; // the gameplay HUD drew in this group's cell (the footprint, mode 1)
shared uint s_cut_box[16]; // the HUD's content box per cut (ui_menu_hud_off_canvas: K and W
                           // lost it in the HUD's rows, so mode 1 did not see it there)
shared vec3 s_strip_t[32];
shared vec3 s_strip_k[32];
shared vec4 s_veil; // the kept K and W's own veil (T_v luma < 1: the menu's dim got in), K_v
shared vec3 s_veil_t;

void main() {
    const uint li = gl_LocalInvocationIndex;
    if (li < 2u) {
        s_count[li] = 0u;
    }
    if (li < 16u) {
        s_cut_box[li] = (li & 3u) < 2u ? 0xFFFFFFFFu : 0u;
    }
    if (li == 0u) {
        const bool cell_ok = gl_WorkGroupID.x < FOOTPRINT_STRIDE && gl_WorkGroupID.y < FOOTPRINT_ROWS;
        s_foot = cell_ok ? split.mask[FOOTPRINT_BASE + gl_WorkGroupID.y * FOOTPRINT_STRIDE +
                                      gl_WorkGroupID.x]
                         : 0u;
    }
    // The band's edge columns just below the status clusters (inside the rows kept, never the
    // HUD's): if the menu's dim was kept too (a box of the HUD drawn like it, learnt as the
    // HUD's), its uniform veil shows there and is taken back out of the HUD under it.
    if (li < 32u) {
        const int x = li < 16u ? 4 : pc.band.z - 5;
        const int y = pc.band.w * 250 / 1080 + 6 + int(li % 16u);
        const ivec2 q = pc.band.xy + ivec2(x, y);
        const vec3 k = texelFetch(k_tex, q, 0).rgb;
        s_strip_t[li] = Transmittance(k, texelFetch(w_tex, q, 0).rgb);
        s_strip_k[li] = BlendDomain(k);
    }
    barrier();
    if (li == 0u) {
        vec3 t_sum = vec3(0.0);
        vec3 k_sum = vec3(0.0);
        float t_min = 1e9;
        float t_max = -1e9;
        for (uint i = 0u; i < 32u; ++i) {
            t_sum += s_strip_t[i];
            k_sum += s_strip_k[i];
            t_min = min(t_min, Luma(s_strip_t[i]));
            t_max = max(t_max, Luma(s_strip_t[i]));
        }
        const vec3 tv = t_sum / 32.0;
        const bool veil = t_max - t_min < 0.03 && Luma(tv) < 0.97 && min(tv.r, min(tv.g, tv.b)) >= 0.04;
        s_veil = vec4(k_sum / 32.0, veil ? 1.0 : 0.0);
        s_veil_t = tv;
    }
    barrier();
    const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    bool status = false;
    uint status_cut = 0u;
    if (p.x < pc.band.z && p.y < pc.band.w) {
        for (uint c = 0u; c < pc.cut_count && c < 4u; ++c) {
            const ivec4 r = pc.cut[c];
            if (((pc.flags >> (STATUS_SHIFT + c)) & 1u) != 0u && p.x >= r.x && p.y >= r.y &&
                p.x < r.z && p.y < r.w) {
                status = true;
                status_cut = c;
            }
        }
    }
    if (status) {
        // K and W just before the menu's first draw: the HUD alone, under no veil.
        const ivec2 q = pc.band.xy + p;
        vec3 k = texelFetch(k_tex, q, 0).rgb;
        vec3 w = texelFetch(w_tex, q, 0).rgb;
        if (s_veil.w > 0.5) {
            // The HUD under a uniform veil: K = K_v + T_v * K_h, T = T_v * T_h (blend domain).
            const vec3 tv = s_veil_t;
            const vec3 t_h = clamp(Transmittance(k, w) / tv, 0.0, 1.0);
            const vec3 k_h = clamp((BlendDomain(k) - s_veil.rgb) / tv, 0.0, 1.0);
            k = RawDomain(k_h);
            w = RawDomain(min(k_h + pc.grey * t_h, vec3(1.0)));
        }
        bool saturated;
        const vec4 px = UiPixel(k, w, false, saturated);
        const bool keep = s_foot != 0u;
        imageStore(atlas_img, ivec2(p.x, p.y + pc.band.w), keep ? px : vec4(0.0));
        if (px.a > 4.0 / 255.0) {
            atomicAdd(s_count[keep ? 0u : 1u], 1u);
        }
        if (keep && px.a > 16.0 / 255.0) {
            atomicMin(s_cut_box[4u * status_cut], uint(p.x));
            atomicMin(s_cut_box[4u * status_cut + 1u], uint(p.y));
            atomicMax(s_cut_box[4u * status_cut + 2u], uint(p.x));
            atomicMax(s_cut_box[4u * status_cut + 3u], uint(p.y));
        }
    }
    barrier();
    if (li < 4u && s_cut_box[4u * li + 2u] >= s_cut_box[4u * li]) {
        atomicMin(stats.words[W_CUT_BOX + 4u * li], s_cut_box[4u * li]);
        atomicMin(stats.words[W_CUT_BOX + 4u * li + 1u], s_cut_box[4u * li + 1u]);
        atomicMax(stats.words[W_CUT_BOX + 4u * li + 2u], s_cut_box[4u * li + 2u]);
        atomicMax(stats.words[W_CUT_BOX + 4u * li + 3u], s_cut_box[4u * li + 3u]);
    }
    if (li < 2u && s_count[li] != 0u) {
        atomicAdd(stats.words[li == 0u ? W_MENU_HUD : W_MENU_HUD_OUT], s_count[li]);
    }
    if (li == 2u && s_veil.w > 0.5) {
        atomicMax(stats.words[W_MENU_HUD_VEIL], 1u);
    }
}

#elif MODE == 8

shared uint s_mbox[4];

void main() {
    const uint li = gl_LocalInvocationIndex;
    if (li < 4u) {
        s_mbox[li] = li < 2u ? 0xFFFFFFFFu : 0u;
    }
    barrier();
    const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x < pc.band.z && p.y < pc.band.w) {
        const ivec2 q = pc.band.xy + p;
        if (MarkerPixel(texelFetch(mk_tex, q, 0).rgb, texelFetch(mw_tex, q, 0).rgb)) {
            atomicMin(s_mbox[0], uint(p.x));
            atomicMin(s_mbox[1], uint(p.y));
            atomicMax(s_mbox[2], uint(p.x));
            atomicMax(s_mbox[3], uint(p.y));
        }
    }
    barrier();
    if (li == 0u && s_mbox[2] >= s_mbox[0] && s_mbox[0] != 0xFFFFFFFFu) {
        atomicMin(stats.words[W_MARK_BOX], s_mbox[0]);
        atomicMin(stats.words[W_MARK_BOX + 1u], s_mbox[1]);
        atomicMax(stats.words[W_MARK_BOX + 2u], s_mbox[2]);
        atomicMax(stats.words[W_MARK_BOX + 3u], s_mbox[3]);
    }
}

#endif

// The build-up meter's cut (FLAG_CONDITIONS): cut 3.
bool InConditions(ivec2 p) {
    if ((pc.flags & FLAG_CONDITIONS) == 0u || pc.cut_count < 4u) {
        return false;
    }
    const ivec4 r = pc.cut[3];
    return p.x >= r.x && p.y >= r.y && p.x < r.z && p.y < r.w;
}

// The strip's first row: at least 8 rows below the bottom half, on a multiple of 8
// (VR::Ui::Conditions::StripTop).
int StripTop() {
    return (2 * pc.band.w + 15) & ~7;
}

// Band pixel `p` clears its strip pixel unless the meter's own pixel at that offset writes it
// (an atlas without the strip: nothing), and the gap rows between the bottom half and the strip
// across the whole width (nothing else writes them: the strip's top edge, the bottom half's last
// row and their mips never sample stale memory). The cleared columns reach a mip-2 texel (4 px)
// and more past the widest cut, on a multiple of 8.
void StripClear(ivec2 p) {
    const int top = StripTop();
    const int rows = imageSize(atlas_img).y - top;
    if (rows <= 0) {
        return;
    }
    const int gap = top - 2 * pc.band.w;
    if (p.y < gap) {
        imageStore(atlas_img, ivec2(p.x, 2 * pc.band.w + p.y), vec4(0.0));
    }
    const float k = float(pc.band.z) / 1920.0;
    const int cols = (int(ceil(STRIP_STAGE_X1 * k)) - int(floor(STRIP_STAGE_X0 * k)) + 8 + 7) & ~7;
    if (p.x >= cols || p.y >= rows) {
        return;
    }
    const bool on = (pc.flags & FLAG_CONDITIONS) != 0u && pc.cut_count > 3u;
    const ivec2 size = on ? pc.cut[3].zw - pc.cut[3].xy : ivec2(0);
    if (p.x < size.x && p.y < size.y) {
        return;
    }
    imageStore(atlas_img, ivec2(p.x, top + p.y), vec4(0.0));
}

shared uint s_count[10];
shared uint s_box[4];
shared uint s_obox[4]; // the box of the opaque UI only (W_OPAQUE_BOX)
shared uint s_cut_box[16];
shared uint s_mask[16][2]; // this group's rows of the dynamic region's bit mask
shared uint s_foot;        // gameplay: this group's cell holds status-cluster UI
shared uint s_foot_seen;   // a full menu: the gameplay HUD drew in this group's cell

void main() {
    const uint li = gl_LocalInvocationIndex;
    const uint cell = gl_WorkGroupID.y * FOOTPRINT_STRIDE + gl_WorkGroupID.x;
    const bool cell_ok = gl_WorkGroupID.x < FOOTPRINT_STRIDE && gl_WorkGroupID.y < FOOTPRINT_ROWS;
    if (li < 10u) {
        s_count[li] = 0u;
    }
    if (li < 4u) {
        s_box[li] = li < 2u ? 0xFFFFFFFFu : 0u;
        s_obox[li] = li < 2u ? 0xFFFFFFFFu : 0u;
    }
    if (li < 16u) {
        s_cut_box[li] = (li & 3u) < 2u ? 0xFFFFFFFFu : 0u;
    }
    if (li < 32u) {
        s_mask[li / 2u][li % 2u] = 0u;
    }
    if (li == 0u) {
        s_foot = 0u;
        s_foot_seen = (pc.flags & FLAG_MENU_BOX) != 0u && cell_ok
                          ? split.mask[FOOTPRINT_BASE + cell]
                          : 0u;
    }
    barrier();
    const int dyn = (pc.flags & FLAG_GAMEPLAY) != 0u ? DynamicCut() : -1;
    const ivec4 dr = dyn >= 0 ? pc.cut[dyn] : ivec4(0);
    // The group's first column in the mask (its 16 columns straddle at most two words).
    const int group_x0 = int(gl_WorkGroupID.x) * 16;
    const int word0 = dyn >= 0 ? (group_x0 - dr.x) >> 5 : 0;
    const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x < pc.band.z && p.y < pc.band.w) {
        const ivec2 q = pc.band.xy + p;
        const vec3 w = texelFetch(w_tex, q, 0).rgb;
        vec3 k = texelFetch(k_tex, q, 0).rgb;
        bool saturated;
        vec3 t = ReadKT(k, w, saturated);
        if ((pc.flags & FLAG_MARKER) != 0u) {
            MarkerCompose(p, k, t);
        }
        vec4 px = UiPixelKT(k, t, true);
        // An area name's corner without its dark backing (not while another lower-group box with
        // its own backing is up). The split's rows still see the name as drawn (it is found by
        // them, VR::Ui::StepAreaName).
        const float split_alpha = px.a;
        if (InAreaKey(p) &&
            (pc.flags & (FLAG_ACTION_PROMPT | FLAG_ITEM_PICKUP | FLAG_DIALOGUE)) == 0u) {
            px = KeyAreaName(px);
        }
        const float alpha = px.a;
        // The build-up meter leaves both halves for the strip (FLAG_CONDITIONS).
        const bool cond = InConditions(p);
        imageStore(atlas_img, p, cond ? vec4(0.0) : px);
        if (cond) {
            imageStore(atlas_img, ivec2(p.x - pc.cut[3].x, StripTop() + p.y - pc.cut[3].y), px);
        }
        StripClear(p);
        bool cut = false;
        bool status = false;
        for (uint c = 0u; c < pc.cut_count && c < 4u; ++c) {
            if (cond && c != 3u) {
                continue; // its pixels belong to the meter's cut alone (first match)
            }
            const ivec4 r = pc.cut[c];
            if (p.x >= r.x && p.y >= r.y && p.x < r.z && p.y < r.w) {
                // The dynamic region is split later (mode 5); outside gameplay it stays whole.
                if (int(c) != DynamicCut()) {
                    cut = true;
                }
                if (((pc.flags >> (STATUS_SHIFT + c)) & 1u) != 0u) {
                    status = true;
                }
                if (alpha > 4.0 / 255.0) {
                    atomicAdd(s_count[3u + c], 1u);
                }
                if (alpha > 16.0 / 255.0) {
                    atomicMin(s_cut_box[4u * c], uint(p.x));
                    atomicMin(s_cut_box[4u * c + 1u], uint(p.y));
                    atomicMax(s_cut_box[4u * c + 2u], uint(p.x));
                    atomicMax(s_cut_box[4u * c + 3u], uint(p.y));
                }
            }
        }
        imageStore(atlas_img, ivec2(p.x, p.y + pc.band.w), cut ? vec4(0.0) : px);
        if (alpha > 4.0 / 255.0) {
            atomicAdd(s_count[0], 1u);
            if (!cut) {
                atomicAdd(s_count[1], 1u);
            }
            if (p.x < 8 || p.y < 8 || p.x >= pc.band.z - 8 || p.y >= pc.band.w - 8) {
                atomicAdd(s_count[2], 1u);
            }
        }
        if (alpha > 250.0 / 255.0) {
            atomicAdd(s_count[7], 1u);
        }
        if (saturated) {
            atomicAdd(s_count[8], 1u);
        }
        if ((pc.flags & FLAG_FOOTPRINT) != 0u && status && alpha > 4.0 / 255.0) {
            atomicOr(s_foot, 1u);
        }
        // A dialog's box leaves the status clusters out; a full menu's only the gameplay HUD's
        // footprint in them (its own title or tabs there count).
        const bool left_out =
            (pc.flags & FLAG_MENU_BOX) != 0u ? status && s_foot_seen != 0u : status;
        if (alpha > 0.25 && !left_out && p.x >= pc.box.x && p.y >= pc.box.y && p.x < pc.box.z &&
            p.y < pc.box.w) {
            atomicMin(s_box[0], uint(p.x));
            atomicMin(s_box[1], uint(p.y));
            atomicMax(s_box[2], uint(p.x));
            atomicMax(s_box[3], uint(p.y));
            // The opaque UI alone (a page such as Status, not a dim over the menu).
            if (alpha > 250.0 / 255.0) {
                atomicMin(s_obox[0], uint(p.x));
                atomicMin(s_obox[1], uint(p.y));
                atomicMax(s_obox[2], uint(p.x));
                atomicMax(s_obox[3], uint(p.y));
            }
        }
        if (dyn >= 0 && split_alpha > 16.0 / 255.0 && p.x >= dr.x && p.y >= dr.y && p.x < dr.z &&
            p.y < dr.w) {
            const int bit = p.x - dr.x;
            atomicOr(s_mask[gl_LocalInvocationID.y][(bit >> 5) - word0], 1u << (bit & 31));
        }
    }
    barrier();
    if (li < 9u && s_count[li] != 0u) {
        const uint word = li < 3u   ? W_CONTENT + li
                          : li < 7u ? W_CUT0 + li - 3u
                          : li == 7u ? W_OPAQUE
                                     : W_SATURATED;
        atomicAdd(stats.words[word], s_count[li]);
    }
    if (li == 0u && s_box[2] >= s_box[0]) {
        atomicMin(stats.words[W_BOX], s_box[0]);
        atomicMin(stats.words[W_BOX + 1u], s_box[1]);
        atomicMax(stats.words[W_BOX + 2u], s_box[2]);
        atomicMax(stats.words[W_BOX + 3u], s_box[3]);
    }
    if (li == 1u && s_obox[2] >= s_obox[0]) {
        atomicMin(stats.words[W_OPAQUE_BOX], s_obox[0]);
        atomicMin(stats.words[W_OPAQUE_BOX + 1u], s_obox[1]);
        atomicMax(stats.words[W_OPAQUE_BOX + 2u], s_obox[2]);
        atomicMax(stats.words[W_OPAQUE_BOX + 3u], s_obox[3]);
    }
    if (li < 4u && s_cut_box[4u * li + 2u] >= s_cut_box[4u * li]) {
        atomicMin(stats.words[W_CUT_BOX + 4u * li], s_cut_box[4u * li]);
        atomicMin(stats.words[W_CUT_BOX + 4u * li + 1u], s_cut_box[4u * li + 1u]);
        atomicMax(stats.words[W_CUT_BOX + 4u * li + 2u], s_cut_box[4u * li + 2u]);
        atomicMax(stats.words[W_CUT_BOX + 4u * li + 3u], s_cut_box[4u * li + 3u]);
    }
    if (li == 0u && (pc.flags & FLAG_FOOTPRINT) != 0u && cell_ok) {
        split.mask[FOOTPRINT_BASE + cell] = s_foot; // every cell, every gameplay frame
    }
    if (dyn >= 0 && li < 32u) {
        const uint row = li / 2u;
        const uint bits = s_mask[row][li % 2u];
        const int y = int(gl_WorkGroupID.y) * 16 + int(row);
        const int word = word0 + int(li % 2u);
        const uint words = MaskWords(dr);
        if (bits != 0u && y >= dr.y && y < dr.w && word >= 0 && uint(word) < words) {
            atomicOr(split.mask[uint(y - dr.y) * words + uint(word)], bits);
        }
    }
}


#if MODE == 0

shared float s_min[256];
shared float s_max[256];
shared vec3 s_sum[256];
shared vec3 s_ksum[256];
shared float s_kmin[256];
shared float s_kmax[256];
shared uint s_n[256];

void main() {
    const uint i = gl_LocalInvocationIndex;
    // Edge strips: band x 0..15 and w-16..w-1, y 400..1040 of a 1440 px band (away from every
    // HUD cluster; the menus' own dim covers them).
    const int y0 = pc.band.w * 400 / 1440;
    const int y1 = pc.band.w * 1040 / 1440;
    const int rows = max(y1 - y0, 1);
    const int total = 32 * rows;
    float mn = 1e9;
    float mx = -1e9;
    vec3 sum = vec3(0.0);
    vec3 ksum = vec3(0.0);
    float kmin = 1e9;
    float kmax = 0.0;
    uint n = 0u;
    for (int p = int(i); p < total; p += 256) {
        const int col = p % 32;
        const int row = p / 32;
        const int bx = col < 16 ? col : pc.band.z - 32 + col;
        const ivec2 q = pc.band.xy + ivec2(bx, y0 + row);
        const vec3 k = texelFetch(k_tex, q, 0).rgb;
        const vec3 w = texelFetch(w_tex, q, 0).rgb;
        const vec3 t = Transmittance(k, w);
        const float tl = Luma(t);
        mn = min(mn, tl);
        mx = max(mx, tl);
        sum += t;
        ksum += k;
        const float kl = Luma(EmissionLinear(k));
        kmin = min(kmin, kl);
        kmax = max(kmax, kl);
        ++n;
    }
    s_min[i] = mn;
    s_max[i] = mx;
    s_sum[i] = sum;
    s_ksum[i] = ksum;
    s_kmin[i] = kmin;
    s_kmax[i] = kmax;
    s_n[i] = n;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1) {
        if (i < stride) {
            s_min[i] = min(s_min[i], s_min[i + stride]);
            s_max[i] = max(s_max[i], s_max[i + stride]);
            s_sum[i] += s_sum[i + stride];
            s_ksum[i] += s_ksum[i + stride];
            s_kmin[i] = min(s_kmin[i], s_kmin[i + stride]);
            s_kmax[i] = max(s_kmax[i], s_kmax[i + stride]);
            s_n[i] += s_n[i + stride];
        }
        barrier();
    }
    if (i < 32u && i > W_STRIP_K) {
        stats.words[i] = 0u; // this frame's counters
    }
    if (i >= W_BOX && i < W_BOX + 4u) {
        stats.words[i] = i < W_BOX + 2u ? 0xFFFFFFFFu : 0u; // an empty box
    }
    if (i >= W_OPAQUE_BOX && i < W_OPAQUE_BOX + 2u) {
        stats.words[i] = 0xFFFFFFFFu; // an empty box (its max words were cleared above)
    }
    if (i >= W_CUT_BOX && i < W_CUT_BOX + 16u) {
        stats.words[i] = ((i - W_CUT_BOX) & 3u) < 2u ? 0xFFFFFFFFu : 0u;
    }
    if (i >= W_MARK_BOX && i < W_MARK_BOX + 4u) {
        stats.words[i] = i < W_MARK_BOX + 2u ? 0xFFFFFFFFu : 0u;
    }
    if (i == 0u) {
        const float count = max(float(s_n[0]), 1.0);
        const vec3 t_mean = s_sum[0] / count;
        const vec3 k_mean = s_ksum[0] / count;
        const float mean = Luma(t_mean);
        const float spread = s_max[0] - s_min[0];
        const float k_spread = s_kmax[0] - s_kmin[0];
        // A uniform dim or fade over the whole screen (the strips agree), not a uniform tint
        // that lets everything through.
        const bool veil = (pc.flags & FLAG_VEIL) != 0u && s_n[0] > 0u && spread < 0.03 &&
                          k_spread < 0.01 && mean < 0.97;
        stats.words[W_VEIL] = floatBitsToUint(veil ? mean : 1.0);
        stats.words[W_VEIL_ON] = veil ? 1u : 0u;
        stats.words[W_STRIP_T] = floatBitsToUint(mean);
        stats.words[W_STRIP_D] = floatBitsToUint(spread);
        stats.words[W_STRIP_K] = floatBitsToUint(s_kmax[0]);
        stats.words[W_STRIP_KD] = floatBitsToUint(k_spread);
        for (uint c = 0u; c < 3u; ++c) {
            stats.words[W_VEIL_T + c] = floatBitsToUint(veil ? t_mean[c] : 1.0);
            stats.words[W_VEIL_K + c] = floatBitsToUint(veil ? k_mean[c] : 0.0);
        }
    }
}


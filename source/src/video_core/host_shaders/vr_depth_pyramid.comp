#version 450

// VrDepthPyramid (vr_depth_pyramid.h): the AO pass's depth, both eyes, in blocks of 2 to 32 texels
// a side (levels 1 to 5), each block's nearest and farthest raw depth (min and max: the shader
// picks by the projection's direction). A workgroup takes a 32 x 32 tile of level 0: each thread
// a 2 x 2 (level 1), then halves in shared memory down to the tile's one level-5 texel.
// The buffer: a 16-word header (level 0's width and height, the levels, the tag, level 1..5's first
// texel), then 2 words a texel (min, max) by level, eye, row.
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler2D depth_left;
layout(binding = 1) uniform sampler2D depth_right;
layout(std430, binding = 2) writeonly buffer Pyramid {
    uint words[];
};

layout(push_constant) uniform Push {
    uvec2 size0;
    uint tag;
    uint pad;
} push;

const uint Levels = 5;
const uint HeaderWords = 16;

shared vec2 tile[16][16];

uvec2 LevelSize(uint level) {
    const uint round = (1u << level) - 1u;
    return max((push.size0 + round) >> level, uvec2(1));
}

// Level `level`'s first texel (both eyes' planes before it, from level 1).
uint LevelFirst(uint level) {
    uint first = 0;
    for (uint l = 1; l < level; ++l) {
        const uvec2 s = LevelSize(l);
        first += 2u * s.x * s.y;
    }
    return first;
}

void Store(uint level, uvec2 at, uint eye, vec2 range) {
    const uvec2 s = LevelSize(level);
    if (at.x >= s.x || at.y >= s.y) {
        return;
    }
    const uint texel = LevelFirst(level) + eye * s.x * s.y + at.y * s.x + at.x;
    words[HeaderWords + 2u * texel] = floatBitsToUint(range.x);
    words[HeaderWords + 2u * texel + 1u] = floatBitsToUint(range.y);
}

float Depth(uint eye, ivec2 at) {
    at = clamp(at, ivec2(0), ivec2(push.size0) - 1);
    return eye == 0u ? texelFetch(depth_left, at, 0).r : texelFetch(depth_right, at, 0).r;
}

void main() {
    const uint eye = gl_WorkGroupID.z;
    const uvec2 local = gl_LocalInvocationID.xy;
    // Level 1: this thread's 2 x 2 of level 0 (clamped at the picture's edges: a block that runs
    // past it holds copies of its edge, never anything else).
    const ivec2 base = ivec2(gl_WorkGroupID.xy * 32u + local * 2u);
    const float a = Depth(eye, base);
    const float b = Depth(eye, base + ivec2(1, 0));
    const float c = Depth(eye, base + ivec2(0, 1));
    const float d = Depth(eye, base + ivec2(1, 1));
    vec2 range = vec2(min(min(a, b), min(c, d)), max(max(a, b), max(c, d)));
    Store(1u, gl_WorkGroupID.xy * 16u + local, eye, range);
    tile[local.y][local.x] = range;
    barrier();
    // Levels 2 to 5: each a quarter of the threads of the one before.
    for (uint level = 2u; level <= Levels; ++level) {
        const uint n = 16u >> (level - 1u);
        const bool working = local.x < n && local.y < n;
        vec2 r = vec2(0.0);
        if (working) {
            const vec2 p0 = tile[2u * local.y][2u * local.x];
            const vec2 p1 = tile[2u * local.y][2u * local.x + 1u];
            const vec2 p2 = tile[2u * local.y + 1u][2u * local.x];
            const vec2 p3 = tile[2u * local.y + 1u][2u * local.x + 1u];
            r = vec2(min(min(p0.x, p1.x), min(p2.x, p3.x)), max(max(p0.y, p1.y), max(p2.y, p3.y)));
        }
        barrier();
        if (working) {
            tile[local.y][local.x] = r;
            Store(level, gl_WorkGroupID.xy * n + local, eye, r);
        }
        barrier();
    }
    // The header (one invocation).
    if (gl_WorkGroupID.x == 0u && gl_WorkGroupID.y == 0u && eye == 0u && local.x == 0u && local.y == 0u) {
        words[0] = push.size0.x;
        words[1] = push.size0.y;
        words[2] = Levels;
        words[3] = push.tag;
        for (uint l = 1u; l <= Levels; ++l) {
            words[3u + l] = LevelFirst(l);
        }
    }
}

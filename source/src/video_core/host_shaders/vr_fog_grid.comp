#version 450

// VrFogGrid (renderer_vulkan/vr_fog_grid.h; shader_recompiler/ir/passes/fog_grid.h). One thread a
// column of the head's grid, front to back. At every cell:
//  - the mist at its middle (air_light.h Mist, the same numbers and the same sums as
//    emit_spirv_air_light.cpp MistAlong) and the moonlit thin air there (moon_shafts.h: the
//    density, the near and far windows, the phase of emit_spirv_moon_shafts.cpp);
//  - how much of the cell the moon reaches: a few places inside it asked of the game's cascaded
//    shadow atlas (moon_shafts.h's test), moved every frame, blended with what the same place in
//    the world held in the last frames (the picture of the last build, looked up through the
//    camera's move) and kept for the next;
//  - what it sends towards the eye (the mist by its own phase, cut by the shadow's contrast; the
//    thin air's glow, lit places only), then the sums so far: "all the light the air between the
//    eye and this cell's far face sends to the eye" and "how much of what is behind gets through".
//    A cell's own part is exact for a slab of even air (light * (1 - exp(-e L)) / e).
// Out: the buffer the scene's copy reads (fog_grid.h: a header, then two words a cell).
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

const int MAX_PATCHES = 32; // fog_grid.h MaxPatches
const int GROUND_CELLS = 32; // core/vr/mist_ground.h Cells
const int MAX_MOVERS = 12;   // fog_grid.h Stir::MaxMovers
const int MAX_LAMPS = 25;  // fog_grid.h Lamps: MaxLights, the tiles
const ivec3 LAMP_TILES = ivec3(20, 12, 8);

// (A read-only storage buffer, not a uniform one: the rasterizer hands it out of its stream
// buffer at the storage alignment, as every other VR buffer. Every member is a vec4 or an ivec4:
// std430 packs them as an array of dwords. fog_grid.h has the list.)
layout(std430, binding = 0) readonly buffer FogGridParams {
    ivec4 grid;            // cells x, y, z, the frame's tag (never 0: 0 in the header means nothing built)
    vec4 frustum;          // tan x lo, tan y lo, tan x width, tan y width
    vec4 slices;           // near, far, log2(far / near), 1 / that
    vec4 view_to_world[3]; // rows: the rotation, then the camera's place
    vec4 air_colour;       // rgb the moon's, w the mist's reach along the ray
    vec4 mist0;            // time, density, 1 / height, the eye's height over the ground
    vec4 mist1;            // ambient, forward, noise scale, extinction
    vec4 mist2;            // wind xyz, patchy
    vec4 mist3;            // near start, near full, strength, high
    vec4 mist4;            // 1 / haze height, the mist's phase g, towards the moon: brightness, focus
    vec4 moon;             // towards the moon xyz, half the eye distance
    vec4 glow0;            // the thin air: density, reach, phase g, forward share
    vec4 glow1;            // strength, near start, near full, the share of its density that dims
    vec4 glow2;            // far keep, far fade | the taken-over fog's shadow contrast and lit gain
    vec4 shadow;           // the mist's contrast, the lit gain, places a cell, places without a past
    vec4 history;          // this frame's share, jitter on, the frame's number, the past can be read
    vec4 to_last[3];       // this view to the last build's view
    vec4 last_frustum;     // the last build's frustum
    vec4 atlas;            // the compare's sign, width, height, shadows on
    vec4 ends;             // the cascades' far ends in view z
    vec4 cascade[16];      // per cascade: three view-to-shadow rows, then tile corner xy, size, bias
    vec4 patches0;         // fog patches (fog_patches.h): how many, near start, near full, noise scale
    vec4 patches1;         // far start, far end, the noise's drift (a share of the wind), its change in place (1 / s)
    vec4 patches2;         // the patches' own colour (fog_patches.h TintNow), how much of it they take
    vec4 fog_patch[4 * MAX_PATCHES]; // per patch: centre xyz, density | 1 / radii xyz, edge | ground y,
                                 // 1 / fall height (0: none), box, noise | glow, its turn about y, its clear distance
                                 // (cos, sin), 0
    vec4 lamps0;           // the lamps (fog_grid.h Lamps): how many, strength, every cell asks all, the taken-over fog's gain - 1
    vec4 lamp[2 * MAX_LAMPS]; // per light: view position xyz, reach (1 / radius^2) | colour, core
    uvec4 lamp_tiles[480]; // a word a tile (row, column, band): four light indices (255: no more)
    vec4 wake0;            // the hunter's wake in the fog (fog_patches.h Wake): how many points, the reach (m of the ray), the rim, the shove
    vec4 wake_strength[2]; // each point's strength
    vec4 wake[8];          // each point's place (the ground's y), 1 / its radius squared
    vec4 patch_rect[MAX_PATCHES]; // the columns each patch can be seen in: first x, first y, last x, last y
    vec4 lamp_shape;       // a lamp's light in the taken-over fog (fog_grid.h Lamps::Taken*): forward share, g, dim, cap
    vec4 lamp_free[2 * MAX_LAMPS]; // a lamp's free lengths before a wall along the world's axes: +x +y +z | -x -y -z
    vec4 organic;          // the taken-over banks (fog_patches.h Organic): billow, the merge's limit, the outline's break-up, its own shade (per unit of column)
    vec4 patch_slope[MAX_PATCHES]; // each patch's ground: its rise per metre along the world's x and z, 0, 0 (fog_patches.h Slope)
    vec4 clearings;        // lanes of thinner fog through crowded banks (fog_patches.h Organic::ClearNow): the share, 2 pi / the width, the merge's limit by the banks' shapes (0 or 1), how much the wisps' wave bends the lanes
    vec4 layers;           // the wisps' strength by the height (fog_patches.h Organic::LayersNow): at the ground, 1 / the height's scale, high up, the share of the low fog that stays at the hunter's feet
    vec4 world_vol;        // the world-fixed volume (fog_grid.h World): its low corner in the world, 1 when it is on
    vec4 lamp_fall;        // a lamp's light dies in the fog (fog_grid.h Lamps::Fall*): per metre in the taken-over banks, in the mist, the even distance, times this in the mist
    vec4 ground_head;      // the mist's ground from the map (core/vr/mist_ground.h): the lattice's low corner (x, z), 1 / a cell's width, 1 when it is on
    vec4 ground[GROUND_CELLS * GROUND_CELLS / 4]; // its cells' ground heights (the world's y), row by row
    vec4 stir0;            // the fog stirred by what moves through it (fog_grid.h Stir): the frame's seconds, 1 when it is on, how many movers, tests' bits
    vec4 stir1;            // the last frame's volume corner (x, z), 1 when the last field is there, 0
    vec4 stir2;            // what a frame keeps: of the push aside, of the clearing, of the churn; the share that spreads
    vec4 mover[2 * MAX_MOVERS]; // a mover: its place (x, its low y, z), 1 / r^2 | its speed (x, z; m/s), its strength, its churn
    vec4 lamp_far;         // a lamp's light gets further in fog much darker than it (fog_grid.h Lamps::Far*): what it dies less by a metre past the even distance in the taken-over banks, in the mist; the contrast it begins at, 1 / the contrast's span
} par;

layout(std430, binding = 1) writeonly restrict buffer FogGrid {
    uint words[];
} fog;

// The moon's shadow atlas (the game's depth image, four cascades in tiles), the lit shares of the
// last build (blended look-ups) and this build's.
layout(binding = 2) uniform sampler2D moon_atlas;
layout(binding = 3) uniform sampler3D last_lit;
layout(binding = 4, LIT_FORMAT) uniform writeonly restrict image3D lit_out;
// The world-fixed volume (fog_grid.h World): the taken-over banks' fog at fixed places of the
// world, x and z across the picture, y its depth: r the fog there, g its plain-light weight.
// Written by this shader built with WORLD_VOLUME (one thread a column of cubes), read by the grid.
#ifdef WORLD_VOLUME
layout(binding = 5, WORLD_FORMAT) uniform writeonly restrict image3D world_out;
layout(binding = 6) uniform sampler2D stir_tex; // this frame's stir field (fog_grid.h Stir)
#else
layout(binding = 5) uniform sampler3D world_tex;
#endif
#ifdef STIR_FIELD
layout(binding = 6, rgba16f) uniform writeonly restrict image2D stir_out;
layout(binding = 7) uniform sampler2D stir_last;
#endif
// The stir field's rules (fog_grid.h Stir).
const float STIR_ASIDE = 0.35;   // fog is pushed aside by this share of a mover's radius at most
const float STIR_DRAG = 0.2;     // ... and dragged along by this share of the mover's way
const float STIR_MAX_M = 1.5;    // never further than this
const float STIR_RIM = 0.9;      // what a mover displaced lies thicker round it (fog_patches.h Wake::Rim)
const float STIR_FLOW = 0.8;     // churned fog carries the field round (m/s at full churn)
const float STIR_SWIRL_M = 0.5;  // ... and its wisps swirl by this much
const ivec3 WORLD_SIZE = ivec3(128, 128, 48);  // cubes along the world's x, z, y
const vec3 WORLD_CUBE = vec3(0.5, 0.5, 0.25);  // a cube's size along x, z, y (m)
const float WORLD_EDGE_M = 4.0;                // the box's last metres across: cross-faded with the grid's own
const float WORLD_EDGE_Y_M = 1.0;

const uint HEADER_WORDS = 16u;
const float MAX_LIGHT = 64.0;
const float MOONWARD_SMOOTH = 0.7; // fog_grid.h MoonwardSmooth

float Smooth01(float t) {
    t = clamp(t, 0.0, 1.0);
    return t * t * (3.0 - 2.0 * t);
}

// The depth of a slice coordinate (0 at the near plane, cells z at the far one).
float SliceZ(float k) {
    return par.slices.x * exp2(k / float(par.grid.z) * par.slices.z);
}

float Gyroid(vec3 q) {
    return dot(sin(q), cos(q.yzx));
}

uint Code16(float v) {
    return uint(clamp(v, 0.0, 1.0) * 65535.0 + 0.5);
}

// Three numbers in 0..1 from a cell's index (pcg3d).
vec3 Hash3(uvec3 v) {
    v = v * 1664525u + 1013904223u;
    v.x += v.y * v.z;
    v.y += v.z * v.x;
    v.z += v.x * v.y;
    v ^= v >> 16u;
    v.x += v.y * v.z;
    v.y += v.z * v.x;
    v.z += v.x * v.y;
    return vec3(v >> 8u) * (1.0 / 16777216.0);
}

// Does the moon reach this place of the head's view (1) or not (0): its cascade by its depth, its
// place in that cascade's tile of the atlas, one texel; lit when the place's shadow depth passes
// the atlas' within the bias (the game's compare, by its sign), and outside every cascade (beyond
// the shadows' reach). emit_spirv_moon_shafts.cpp's test, the same.
float MoonLit(vec3 p) {
    const int k = p.z > par.ends.x ? (p.z > par.ends.y ? (p.z > par.ends.z ? 3 : 2) : 1) : 0;
    const vec4 h = vec4(p, 1.0);
    const vec3 sc = vec3(dot(par.cascade[4 * k], h), dot(par.cascade[4 * k + 1], h), dot(par.cascade[4 * k + 2], h));
    const vec4 tile = par.cascade[4 * k + 3];
    const bool inside = all(greaterThanEqual(sc.xy, tile.xy)) && all(lessThan(sc.xy, tile.xy + tile.z)) &&
                        p.z <= par.ends.w;
    if (!inside) {
        return 1.0;
    }
    const ivec2 texel = clamp(ivec2(floor(sc.xy * par.atlas.yz)), ivec2(0), ivec2(par.atlas.yz) - 1);
    const float stored = texelFetch(moon_atlas, texel, 0).r;
    return par.atlas.x * (stored - sc.z) >= -tile.w ? 1.0 : 0.0;
}

// A way of the world in a fog patch's own axes (turned about y: its x radius lies along (cos, 0, sin)).
vec3 PatchAxes(int i, vec3 v) {
    const vec2 turn = par.fog_patch[4 * i + 3].yz;
    return vec3(turn.x * v.x + turn.y * v.z, v.y, turn.x * v.z - turn.y * v.x);
}

// A fog patch's density at a place of the world (fog_patches.h): 1 at its heart, thinning over the
// outer share of its radii (round, or a rounded box seen from above); one that hugs the ground
// thins upward from the ground's height.
// `tall`: half the height of the cell asking (m). A bank lower than that is spread over the
// cell's height, the same fog in all: no slab that one row of cells has and the next has not.
// `y_near`, `y_far`: the world's y of the cell's ray at its two ends (the cell reaches `tall` over
// and under them); `half_run`: half the ray's way across the ground between them (x and z: with
// the patch's slope, how much the ground rises along the cell). `wave`: the noise's wide wave at the place (-1.5..1.5): a bank
// of the game's fog taken over is higher where it is high and its outline goes in and out with it
// (fog_patches.h Organic: a billowing top, no clean oval).
// `shade`: the share of the light the bank's fog in the cell gets through the bank's own fog above
// it (fog_patches.h Organic::SelfShadeNow; 1 with none).
// `low`: the share of the bank's fog in the cell that counts as at the ground for its wisps (the
// mean of exp(-height / the layers' scale) over the fog there; below 0: not a bank with a fall).
float PatchAt(int i, vec3 p, float tall, float y_near, float y_far, vec2 half_run, float wave, out float shade,
              out float low) {
    shade = 1.0;
    low = -1.0;
    const vec4 centre = par.fog_patch[4 * i], radii = par.fog_patch[4 * i + 1], more = par.fog_patch[4 * i + 2];
    // (Only as much taller as the cell is taller than the bank: the root of the squares. With the
    // plain sum a bank 0.3 m high was two fifths taller at 10 m than at the eye, and swelled and
    // sank as the eye walked to and from it.)
    const float spread = inversesqrt(1.0 + tall * tall * radii.y * radii.y);
    // (Its ground a plane, fog_patches.h Slope: heights are over the ground here.)
    const vec2 slope = par.patch_slope[i].xy;
    vec3 rel = p - centre.xyz;
    const float rise = dot(slope, rel.xz);
    rel.y -= rise;
    vec3 q = PatchAxes(i, rel) * radii.xyz;
    q.y *= spread;
    const vec2 h2 = q.xz * q.xz;
    const float across = more.z > 0.5 ? sqrt(sqrt(dot(h2, h2))) : sqrt(h2.x + h2.y);
    const bool taken = par.fog_patch[4 * i + 3].x < 0.0;
    const float r = length(vec2(across, q.y)) + (taken ? 0.25 * par.organic.z * wave : 0.0);
    float amount = 1.0 - Smooth01((r - (1.0 - radii.w)) / max(radii.w, 1e-3));
    // (As much fog in the column as before: thinner by what it is taller, by the fall's height
    // where it has one, which is the lower of the two.)
    if (more.y > 0.0) {
        // (The fall's mean over the cell's own heights, exact: all of it under the ground's height,
        // exp(-h / fall) over it. Read at the cell's middle a bank lower than the cell was there or
        // not by where the middle fell, and blinked as the eye walked.)
        const float run = dot(slope, half_run);
        const float h_near = y_near + run - rise - more.x, h_far = y_far - run - rise - more.x;
        const float a = min(h_near, h_far) - tall, b = max(max(h_near, h_far) + tall, a + 1e-3);
        const float under = clamp(-a, 0.0, b - a);
        const float rate = taken ? more.y / clamp(1.0 + par.organic.x * wave, 0.35, 2.5) : more.y;
        const float ea = exp(-rate * max(a, 0.0)), eb = exp(-rate * max(b, 0.0));
        const float over = (ea - eb) / rate;
        if (taken && par.organic.w > 0.0 && amount > 0.0) {
            // (The bank's own column above the cell's foot and above its top, times k: the fog
            // between them gets, weighed by where it is, (exp(-top) - exp(-foot)) / (foot - top)
            // of the light, exact, whatever the cell's height: the same bank far off and at the
            // eye. Times what keeps a heart's whole column as bright as with no shade.)
            const float k = par.organic.w * centre.w * amount;
            const float ca = k * (ea / rate + max(-a, 0.0)), cb = k * (eb / rate + max(-b, 0.0));
            // (The gain: once a bank on the CPU, the slope vec4's z.)
            shade = par.patch_slope[i].z * (ca - cb > 1e-4 ? (exp(-cb) - exp(-ca)) / (ca - cb) : exp(-ca));
        }
        if (taken) {
            // (Of the bank's fog in the cell, how much is at the ground: exp(-height / scale)
            // weighed by the fog, exact as the fall's mean is; all of what is under the ground.)
            const float rate2 = rate + par.layers.y;
            const float over2 = (exp(-rate2 * max(a, 0.0)) - exp(-rate2 * max(b, 0.0))) / rate2;
            low = (under + over2) / max(under + over, 1e-6);
        }
        amount *= (under + over) / (b - a);
    } else {
        amount *= spread;
    }
    return centre.w * amount;
}

// The ground's height under the air's mist at a place of the world (core/vr/mist_ground.h): between
// the lattice's four cells round it; `level`: the one level plane's height, without a lattice.
float MistGround(vec2 xz, float level) {
    if (par.ground_head.w < 0.5) {
        return level;
    }
    const vec2 g = clamp((xz - par.ground_head.xy) * par.ground_head.z - 0.5, vec2(0.0), vec2(float(GROUND_CELLS - 1)));
    const ivec2 lo = ivec2(g), hi = min(lo + 1, ivec2(GROUND_CELLS - 1));
    const vec2 f = g - vec2(lo);
    const int a = lo.y * GROUND_CELLS + lo.x, b = lo.y * GROUND_CELLS + hi.x;
    const int c = hi.y * GROUND_CELLS + lo.x, d = hi.y * GROUND_CELLS + hi.x;
    return mix(mix(par.ground[a >> 2][a & 3], par.ground[b >> 2][b & 3], f.x),
               mix(par.ground[c >> 2][c & 3], par.ground[d >> 2][d & 3], f.x), f.y);
}

// 1 / the square of how far lamp `i`'s light gets towards a place `d` from it (the grid's view)
// before a wall (core/vr/map_lights.h ReachAlong: between its free lengths along the world's axes,
// by the squares of the direction's parts).
float LampWall(uint i, vec3 d) {
    const vec3 w = vec3(dot(par.view_to_world[0].xyz, d), dot(par.view_to_world[1].xyz, d), dot(par.view_to_world[2].xyz, d));
    // (The box of the six lengths, core/vr/map_lights.h ReachAlong: `t` times the way to the
    // place is where its direction leaves the box.)
    const vec3 free = mix(par.lamp_free[2u * i + 1u].xyz, par.lamp_free[2u * i].xyz, greaterThan(w, vec3(0.0)));
    const vec3 ts = free / max(abs(w), vec3(1e-4));
    const float t = min(ts.x, min(ts.y, ts.z));
    return 1.0 / max(dot(w, w) * t * t, 1e-4);
}

// How much further lamp `i`'s light gets at a place `away` from it (fog_grid.h Lamps::Far*): the
// metres past the even distance, times the share the contrast gives (the lamp's own light at the
// even distance, lamp_free's w, by 1 / the fog's own light here).
float LampFurther(uint i, float per_own, float away) {
    const float t = clamp((par.lamp_free[2u * i].w * per_own - par.lamp_far.z) * par.lamp_far.w, 0.0, 1.0);
    return t * t * (3.0 - 2.0 * t) * max(away - par.lamp_fall.z, 0.0);
}

// A taken-over bank the volume holds: one with a fall and no clear distance of its own.
bool InVolume(int i) {
    return par.world_vol.w > 0.5 && par.fog_patch[4 * i + 3].x < 0.0 && par.fog_patch[4 * i + 2].y > 0.0 &&
           par.fog_patch[4 * i + 3].w <= 0.0;
}

// What a cube of the world-fixed volume holds at its middle `p` (the taken-over fog there, its
// plain-light weight): what the grid's own way gives a place (its loop over the patches below, kept
// in step with it): the banks' shapes by PatchAt, the wisps, the merge's limit, the clearings, the
// hunter's push. `mask`: the banks to ask.
// `stir`: what the stir field holds for the place's column (fog_grid.h Stir): where its wisps are
// read (x, z, from the place), the share of the fog that stays; a share below 0: no field, the
// hunter's point wake.
vec2 VolumeAt(vec3 p, uint mask, vec3 patch_drift, int wakes, vec3 stir) {
    float taken = 0.0, plain = 0.0, shape_sum = 0.0;
    float keep = 1.0;
    vec3 shoved = vec3(0.0);
    if (stir.z >= 0.0) {
        keep = stir.z;
        shoved.xz = stir.xy;
        wakes = 0;
    }
    for (int w = 0; w < wakes; ++w) {
        const vec3 off = p - par.wake[w].xyz;
        const float x = (dot(off.xz, off.xz) + 0.25 * off.y * off.y) * par.wake[w].w;
        const float heart = 1.0 / (1.0 + x * x);
        const float s = par.wake_strength[w >> 2][w & 3];
        keep *= 1.0 - s * (heart - par.wake0.z * x * heart);
        shoved.xz -= off.xz * (s * heart * par.wake0.w);
    }
    const vec3 noise_at = (p + shoved) * par.patches0.w + patch_drift;
    const float wave = Gyroid(noise_at * 0.303 + vec3(3.1, 0.7, 5.3));
    // (A cube is half a metre: it holds every wave.)
    const float wisp = 0.20 * wave + 0.22 * Gyroid(noise_at) + 0.11 * Gyroid(noise_at * 2.17 + vec3(1.7, 4.1, 2.9));
    for (uint left = mask; left != 0u; left &= left - 1u) {
        const int i = findLSB(left);
        float shade;
        float low;
        float amount = PatchAt(i, p, 0.5 * WORLD_CUBE.z, p.y, p.y, vec2(0.0), wave, shade, low);
        if (amount <= 0.0) {
            continue;
        }
        shape_sum += amount;
        const float wisps = par.fog_patch[4 * i + 2].w *
                            (low < 0.0 ? 1.0 : par.layers.z - (par.layers.z - par.layers.x) * low);
        amount *= max(1.0 + wisps * 2.0 * wisp, 0.0);
        taken += amount;
        plain += amount * -par.fog_patch[4 * i + 3].x * shade;
    }
    if (par.organic.y > 0.0 && taken > 1e-6) {
        const float sum = par.clearings.z > 0.5 ? max(shape_sum, 1e-6) : taken;
        const float kept = par.organic.y * (1.0 - exp(-sum / par.organic.y)) / sum;
        taken *= kept;
        plain *= kept;
    }
    if (par.clearings.x > 0.0 && taken > 1e-6) {
        vec2 g = noise_at.xz / par.patches0.w * par.clearings.y;
        g += par.clearings.w * vec2(wave, sin(g.x * 0.37 - g.y * 0.53 + 1.7 * wave));
        const float lanes = sin(g.x * 0.94 + g.y * 0.34) * sin(g.y * 0.71 - g.x * 0.29 + 1.3) +
                            0.5 * sin(g.x * 1.31 + g.y * 1.57 + 4.1) + 0.3 * sin(g.x * 2.63 - g.y * 2.11 + 0.6);
        const float crowd = par.organic.y > 0.0 ? clamp(taken / (0.6 * par.organic.y), 0.0, 1.0) : 1.0;
        const float left = 1.0 - par.clearings.x * crowd * Smooth01(lanes * 0.9 + 0.2);
        taken *= left;
        plain *= left;
    }
    return vec2(taken, plain) * keep;
}

#ifdef WORLD_VOLUME
// The volume's build: a thread a column of cubes.
void main() {
    const ivec2 col = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(col, WORLD_SIZE.xy))) {
        return;
    }
    const vec3 corner = par.world_vol.xyz;
    const vec2 xz = corner.xz + (vec2(col) + 0.5) * WORLD_CUBE.xy;
    const int patches = clamp(int(par.patches0.x), 0, MAX_PATCHES);
    const float grow = 1.0 + 0.375 * par.organic.z;
    uint mask = 0u;
    // (The heights the column's banks reach at all, each one's radius up and down with its
    // outline's break-up: the cubes over and under them hold nothing and ask nothing.)
    float y_lo = 1e9, y_hi = -1e9;
    for (int i = 0; i < patches; ++i) {
        if (!InVolume(i)) {
            continue;
        }

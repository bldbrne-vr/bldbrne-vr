                            // same as when looking underneath"). Far off a wave 3.3 times as wide
                            // stands in for the main one: soft banks, the same contrast.)
                            // (The wisps the same at every distance (2026-11-17: "they
                            // shouldn't be flying around when we walk around"): where a cell is too long
                            // to hold a wisp at one place, it is read at up to four places along the
                            // cell, a quarter of the main wave apart at most. Until then a wave was
                            // faded out by the cell's length: a bank had its wisps and holes only
                            // within some metres of the camera and was a smooth lump beyond, and
                            // changed as one walked at it or zoomed.)
                            const float cell_all = len * par.patches0.w;
                            wisp_n = clamp(int(ceil(cell_all / 1.5)), 1, 4);
                            const float cell = cell_all / float(wisp_n);
                            const float main_wave = clamp(2.0 - cell * 0.3183, 0.0, 1.0);
                            const float fine_wave = clamp(2.0 - cell * 0.6907, 0.0, 1.0);
                            const float wide_wave = clamp(2.0 - cell * 0.0965, 0.0, 1.0);
                            const vec3 across = world_ray * ((z1 - z0) / float(places_here) * par.patches0.w);
                            for (int w = 0; w < wisp_n; ++w) {
                                const vec3 qw = q + across * ((float(w) + 0.5) / float(wisp_n) - 0.5);
                                float x = 0.20 * wide_wave * wave;
                                if (main_wave > 0.0) {
                                    x += 0.22 * main_wave * Gyroid(qw);
                                }
                                if (fine_wave > 0.0) {
                                    x += 0.11 * fine_wave * Gyroid(qw * 2.17 + vec3(1.7, 4.1, 2.9));
                                }
                                wisp_x[w] = x;
                            }
                            noise = 1.0; // (read)
                        }
                        if (held) {
                            amount *= 1.0 - vol;
                        }
                        float shape = amount;
                        // (A calm heavy pool at the ground, ragged wisps above: the wisps' strength
                        // by where the bank's fog in the cell is, fog_patches.h Organic::LayersNow.)
                        const float wisps = par.fog_patch[4 * i + 2].w *
                                            (low < 0.0 ? 1.0 : par.layers.z - (par.layers.z - par.layers.x) * low);
                        float wisped = 0.0;
                        for (int w = 0; w < wisp_n; ++w) {
                            wisped += max(1.0 + wisps * 2.0 * wisp_x[w], 0.0);
                        }
                        amount *= wisped / float(wisp_n);
                        const float whole = amount; // (before its own clear distance)
                        // (Its own clear distance from the eye, fog_patches.h Patch::clear: none
                        // within 0.4 of it, all of it from there on.)
                        const float clear = par.fog_patch[4 * i + 3].w;
                        if (clear > 0.0) {
                            const float cleared = Smooth01((ts - 0.4 * clear) / (0.6 * clear));
                            amount *= cleared;
                            shape *= cleared;
                        }
                        here += amount;
                        // (A glow below 0: the game's own fog taken over, fog_patches.h Pick.)
                        const float glow = par.fog_patch[4 * i + 3].x;
                        here_light += amount * max(glow, 0.0);
                        here_plain += amount * max(-glow, 0.0) * shade;
                        here_taken += glow < 0.0 ? amount : 0.0;
                        here_shape += glow < 0.0 ? shape : 0.0;
                        if (glow < 0.0 && low > 0.0) {
                            here_feet += whole * low;
                            here_feet_plain += whole * low * -glow * shade;
                        }
                    }
                }
                // (The taken-over banks that overlap merge: a soft limit on their sum, so two
                // banks are one bank with more and less of it, not a bright double; fog_patches.h
                // Organic::MergeCap.)
                if (par.organic.y > 0.0 && here_taken > 1e-6) {
                    // (By the banks' shapes where asked, fog_patches.h Organic::MergeByShape: their
                    // wisps stay as deep as one bank's.)
                    const float sum = par.clearings.z > 0.5 ? max(here_shape, 1e-6) : here_taken;
                    const float kept = par.organic.y * (1.0 - exp(-sum / par.organic.y)) / sum;
                    here -= here_taken * (1.0 - kept);
                    here_plain *= kept;
                    here_taken *= kept;
                    here_feet *= kept;
                    here_feet_plain *= kept;
                }
                // (Clearings where much fog lies together, fog_patches.h Organic::ClearNow: slow
                // lanes over the ground's x and z, the same at every height, moving with the wind.
                // They take by how near the banks here are to their merge's limit: a lone bank's
                // thin rim keeps what it has.)
                if (par.clearings.x > 0.0 && here_taken > 1e-6) {
                    // (Bent by the wisps' own wide wave, which drifts and changes where it stands:
                    // no lane is straight, none comes round again; "a little chaotic like real
                    // fog", the tester, 2026-11-16. A third, finer set crosses the two wide ones.)
                    vec2 g = noise_at.xz / par.patches0.w * par.clearings.y;
                    g += par.clearings.w * vec2(wave, sin(g.x * 0.37 - g.y * 0.53 + 1.7 * wave));
                    const float lanes = sin(g.x * 0.94 + g.y * 0.34) * sin(g.y * 0.71 - g.x * 0.29 + 1.3) +
                                        0.5 * sin(g.x * 1.31 + g.y * 1.57 + 4.1) +
                                        0.3 * sin(g.x * 2.63 - g.y * 2.11 + 0.6);
                    const float crowd = par.organic.y > 0.0 ? clamp(here_taken / (0.6 * par.organic.y), 0.0, 1.0) : 1.0;
                    const float left = 1.0 - par.clearings.x * crowd * Smooth01(lanes * 0.9 + 0.2);
                    here -= here_taken * (1.0 - left);
                    here_plain *= left;
                    here_taken *= left;
                    here_feet *= left;
                    here_feet_plain *= left;
                }
                here *= keep;
                here_light *= keep;
                here_plain *= keep;
                here_taken *= keep;
                // (What the volume holds here; its own push is in it.)
                here += vol_fog.x;
                here_taken += vol_fog.x;
                here_plain += vol_fog.y;
                const float near_part = Smooth01((ts - par.patches0.y) * patch_near);
                const float far_part = Smooth01((par.patches1.y - ts) * patch_far);
                const float fade = near_part * far_part;
                more += here * fade;
                more_light += here_light * fade;
                more_plain += here_plain * fade;
                more_taken += here_taken * fade;
                // (A little of the low fog stays at the hunter's feet inside the near clearing,
                // pushed by his steps as the rest is: fog_patches.h Feet.)
                const float stays = par.layers.w * (1.0 - near_part) * far_part * keep;
                if (stays > 0.0) {
                    more += here_feet * stays;
                    more_plain += here_feet_plain * stays;
                    more_taken += here_feet * stays;
                }
            }
            if (!(isnan(more) || isinf(more) || isnan(more_light) || isinf(more_light) || isnan(more_plain) ||
                  isinf(more_plain))) {
                const float had = mist;
                const float each = 1.0 / float(places_here);
                mist = clamp(mist + each * more, 0.0, 16.0);
                patch_light = clamp(each * more_light, 0.0, 64.0) - (mist - had);
                patch_plain = clamp(each * more_plain, 0.0, 64.0);
                // (The taken-over fog's share of the cell's mist: that much of it takes their colour.)
                patch_share = mist > 1e-5 && !(isnan(more_taken) || isinf(more_taken))
                                  ? clamp(each * more_taken / mist, 0.0, 1.0)
                                  : 0.0;
            }
        }
        // The moonlit thin air here: thickening from its near start to its near full (what is at
        // your hands stays clear), thinning out over the second half of its reach.
        const float glow_air =
            glow_on ? Smooth01((glow_far - t) * 2.0 / glow_far) * Smooth01((t - par.glow1.y) * glow_near) : 0.0;

        // How much of the cell the moon reaches.
        float lit = 1.0;
        if (shadows) {
            if (mist > 1e-5 || glow_air > 1e-4) {
                // Where this cell's middle was in the last build's grid: its lit share then.
                float before = -1.0;
                if (past) {
                    const vec4 centre = vec4(tangent * zm, zm, 1.0);
                    const vec3 was = vec3(dot(par.to_last[0], centre), dot(par.to_last[1], centre),
                                          dot(par.to_last[2], centre));
                    if (was.z > par.slices.x) {
                        const vec3 uvw = vec3((was.xy / was.z - par.last_frustum.xy) / par.last_frustum.zw,
                                              log2(was.z / par.slices.x) * par.slices.w);
                        if (all(greaterThanEqual(uvw, vec3(0.0))) && all(lessThanEqual(uvw, vec3(1.0)))) {
                            before = textureLod(last_lit, uvw, 0.0).r;
                        }
                    }
                }
                // This frame's places inside the cell: spread along its depth (where a cell is
                // longest), each one's place across it its own; all moved from frame to frame (each
                // cell its own sequence: the sum along a column and the blend of eight cells at a
                // pixel average them out).
                const int places = int(clamp(before < 0.0 ? par.shadow.w : par.shadow.z, 1.0, 16.0));
                vec3 jitter = vec3(0.5);
                if (moving) {
                    jitter = fract(Hash3(uvec3(column, k)) +
                                   par.history.z * vec3(0.7548776662, 0.5698402910, 0.6180339887));
                }
                float now = 0.0;
                for (int i = 0; i < places; ++i) {
                    const vec2 across =
                        moving ? fract(jitter.xy + float(i) * vec2(0.6180339887, 0.7548776662)) : vec2(0.5);
                    const float z = SliceZ(float(k) + (float(i) + jitter.z) / float(places));
                    now += MoonLit(vec3((par.frustum.xy + cell_tan * (vec2(column) + across)) * z, z));
                }
                now /= float(places);
                lit = before < 0.0 ? now : mix(before, now, clamp(par.history.x, 0.0, 1.0));
            }
            imageStore(lit_out, ivec3(column, k), vec4(lit));
        }

        // A slab of even air: what it sends, seen through itself; then through all before it.
        // The mist's light by the shadow's contrast (what is lit counts the lit gain times); the
        // thin air's from lit places only, a little less the deeper it sits in its own air.
        const float mist_light =
            max(mist + patch_light, 0.0) * mist_phase * max(1.0 + shadow_contrast * (lit * par.shadow.y - 1.0), 0.0) +
            patch_plain * plain_phase * max(1.0 + par.glow2.z * (lit * par.glow2.w - 1.0), 0.0);
        const float glow_here = glow_light * glow_air * exp(-glow_density * t) * lit;
        // (The thin air's own dimming darkens what is behind it, never the air's light: the
        // marched glow's rule, which its strengths were chosen with.)
        const float e = par.mist1.w * mist;
        const float slab = exp(-e * len);
        const float sent = e > 1e-6 ? (1.0 - slab) / e : len;
        sum += mix(par.air_colour.rgb, par.patches2.rgb, patch_share * par.patches2.w) * (through * mist_light * sent);
        // The lamps in this cell's mist: the lights of its tile (four at most), each its colour
        // times the game's falloff, softened by the cell's own length. Only with a light this
        // frame, only a cell with mist, only a tile a light reaches.
        if (lamps > 0 && mist > 1e-4) {
            const int band = int(float(k) * lamp_bands);
            if (band != lamp_band) {
                lamp_band = band;
                const int t = lamp_first + band;
                lamp_word = par.lamp_tiles[t >> 2][t & 3];
            }
            if (lamp_word != 0xFFFFFFFFu || lamps_all) {
                const vec3 p = vec3(tangent * zm, zm);
                const float soft = 0.25 * len * len;
                vec3 lit_by = vec3(0.0);
                // (In the game's fog taken over a lamp's light travels: fog_grid.h Lamps::Taken*.)
                vec3 lit_taken = vec3(0.0);
                const bool taken_here = patch_share > 0.0;
                const float shape_g = par.lamp_shape.y, shape_g2 = shape_g * shape_g;
                // (1 / the fog's own light here for its amount: what a lamp's light stands out
                // from, fog_grid.h Lamps::Far*.)
                const float per_own =
                    mist / max(dot(mix(par.air_colour.rgb, par.patches2.rgb, patch_share * par.patches2.w), vec3(0.3, 0.6, 0.1)) * mist_light, 1e-6 * mist);
                if (!lamps_all) {
                    for (uint w = lamp_word; (w & 255u) != 255u; w = (w >> 8) | 0xFF000000u) {
                        const vec4 a = par.lamp[2u * (w & 255u)], b = par.lamp[2u * (w & 255u) + 1u];
                        const vec3 d = p - a.xyz;
                        const float d2 = dot(d, d);
                        // (No further than the wall that way: the falloff ends at the shorter reach.)
                        const float reaches = max(1.0 / (d2 + b.w + soft) - max(a.w, LampWall(w & 255u, d)), 0.0);
                        if (reaches <= 0.0) {
                            continue;
                        }
                        // (The light dies on its way through the fog, fog_grid.h Lamps::Fall*: by the
                        // distance, the same in a wisp and in a hole of the bank.)
                        const float away = sqrt(max(d2, 1e-4));
                        const float further = LampFurther(w & 255u, per_own, away);
                        lit_by += b.rgb * (reaches * par.lamp_fall.w * exp(par.lamp_far.y * further - par.lamp_fall.y * away));
                        if (taken_here) {
                            // (The turn the light makes at the fog to reach the eye: none, its cosine 1,
                            // looking at the lamp through the fog.)
                            const float turn = -dot(d, dir) / away;
                            const float lobe = max(1.0 + shape_g2 - 2.0 * shape_g * turn, 1e-3);
                            const float phase = mix(1.0, (1.0 - shape_g2) / (lobe * sqrt(lobe)), par.lamp_shape.x);
                            lit_taken += b.rgb * (reaches * phase * exp(par.lamp_far.x * further - (par.lamp_shape.z * mist + par.lamp_fall.x) * away));
                        }
                    }
                } else {
                    for (int i = 0; i < lamps; ++i) {
                        const vec4 a = par.lamp[2 * i], b = par.lamp[2 * i + 1];
                        const vec3 d = p - a.xyz;
                        const float d2 = dot(d, d);
                        const float reaches = max(1.0 / (d2 + b.w + soft) - max(a.w, LampWall(uint(i), d)), 0.0);
                        if (reaches <= 0.0) {
                            continue;
                        }
                        const float away = sqrt(max(d2, 1e-4));
                        const float further = LampFurther(uint(i), per_own, away);
                        lit_by += b.rgb * (reaches * par.lamp_fall.w * exp(par.lamp_far.y * further - par.lamp_fall.y * away));
                        if (taken_here) {
                            const float turn = -dot(d, dir) / away;
                            const float lobe = max(1.0 + shape_g2 - 2.0 * shape_g * turn, 1e-3);
                            const float phase = mix(1.0, (1.0 - shape_g2) / (lobe * sqrt(lobe)), par.lamp_shape.x);
                            lit_taken += b.rgb * (reaches * phase * exp(par.lamp_far.x * further - (par.lamp_shape.z * mist + par.lamp_fall.x) * away));
                        }
                    }
                }
                // (On the game's fog taken over a lamp's light counts TakenGain times, shaped as above
                // and capped: its hue kept, its brightest part at most the cap.)
                lit_taken *= 1.0 + par.lamps0.w;
                if (par.lamp_shape.w > 0.0) {
                    lit_taken *= min(1.0, par.lamp_shape.w / max(max(lit_taken.r, lit_taken.g), max(lit_taken.b, 1e-6)));
                }
                lamp_sum += mix(lit_by, lit_taken, patch_share) * (through * mist * sent * par.lamps0.y);
            }
        }
        glow_sum += through * glow_here * sent;
        through *= slab;
        dimmed *= exp(-glow_dims * glow_air * len);
        z0 = z1;
        // A surface far beyond the thin air's reach keeps less of the glow in front of it
        // (moon_shafts.h FarKeep; the sky, which looks the last slice up, the least). The fade
        // ends at the grid's end (fog_grid.h GlowFarFade), so the last slice holds its end by
        // this rule itself; where a test's reach is longer than the grid no fade fits and no
        // slice is forced to one (it was: a quarter of the glow over the last slice).
        const float beyond = Smooth01((z1 * stretch - glow_far) / (glow_far * max(par.glow2.y - 1.0, 1e-3)));
        const float keep = 1.0 - (1.0 - par.glow2.x) * beyond;
        const vec3 code =
            sqrt(clamp((sum + lamp_sum + par.air_colour.rgb * (glow_sum * keep)) / MAX_LIGHT, 0.0, 1.0));
        const uint at = first + 2u * uint(k);
        fog.words[at] = Code16(code.r) | (Code16(code.g) << 16);
        fog.words[at + 1u] = Code16(code.b) | (Code16(through * dimmed) << 16);
    }
}
#endif

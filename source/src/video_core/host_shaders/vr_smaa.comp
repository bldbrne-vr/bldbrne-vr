// SMAA 1x in place of the game's FXAA (vr.ini aa_mode=smaa; renderer_vulkan/vr_smaa.cpp,
// core/vr/aa_mode.h). The three passes of the reference implementation (smaa/SMAA.hlsl, MIT:
// Jimenez, Echevarria, Masia, Navarro, Gutierrez 2013; its notice is in that file) run as compute
// shaders over the game frame at its render size, one thread per pixel, preset HIGH (threshold
// 0.1, 16 orthogonal and 8 diagonal search steps, corner rounding 25):
//   SMAA_EDGES:   colour (the game's sRGB-encoded bytes, read as UNORM: luma in gamma space, as
//                 SMAA wants) -> edges (RG8), luma edge detection;
//   SMAA_WEIGHTS: edges + AreaTex + SearchTex -> blending weights (RGBA8);
//   SMAA_BLEND:   colour (an sRGB view: SMAA blends in linear light) + weights -> the output
//                 (the FXAA draw's target, an R8G8B8A8_UNORM storage view), sRGB-encoded again.
//                 Pixels without a weight are copied bit for bit from the UNORM view.
// Every texture is read with explicit LOD 0 through one linear, clamp-to-edge sampler (compute
// shaders have no implicit derivatives), as the reference asks of all its samplers. Every output
// texel is written, so nothing needs clearing between frames.
// FAST_GPU_SMAA_TRIM (vr_smaa.cpp) adds two variants: SMAA_BLEND + SMAA_KEEP, the blend without
// the store for pixels that have no weight (A keeps its own bytes there), and SMAA_WEIGHTS +
// SMAA_COMPACT, the weights pass in 16x16 groups with the pixels that have an edge packed into
// the group's first warps (the same texels, bit for bit).
#version 450
#extension GL_ARB_separate_shader_objects : enable

#if defined(SMAA_WEIGHTS) && defined(SMAA_COMPACT)
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
#else
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
#endif

layout(push_constant) uniform SmaaPush {
    vec4 rt_metrics; // 1 / width, 1 / height, width, height
    ivec2 size;
    uint flags;      // 1: the colour bytes are B, G, R, A (luma weights swapped)
    uint pad;
} pc;

layout(set = 0, binding = 0) uniform sampler2D color_unorm; // the game colour, UNORM view
layout(set = 0, binding = 1) uniform sampler2D color_srgb;  // ... an sRGB view (SMAA_BLEND)
layout(set = 0, binding = 2) uniform sampler2D edges_tex;   // SMAA_WEIGHTS
layout(set = 0, binding = 3) uniform sampler2D area_tex;    // SMAA_WEIGHTS: AreaTex (RG8)
layout(set = 0, binding = 4) uniform sampler2D search_tex;  // SMAA_WEIGHTS: SearchTex (R8)
layout(set = 0, binding = 5) uniform sampler2D blend_tex;   // SMAA_BLEND: the weights
#ifdef SMAA_EDGES
#ifdef SMAA_EDGES_RGBA8
layout(set = 0, binding = 6, rgba8) uniform writeonly image2D out_img;
#else
layout(set = 0, binding = 6, rg8) uniform writeonly image2D out_img;
#endif
#else
layout(set = 0, binding = 6, rgba8) uniform writeonly image2D out_img;
#endif

// The colour in R, G, B order whatever the image's byte order (SMAA's luma weights).
vec4 SmaaPoint(sampler2D tex, vec2 coord) {
    const vec4 c = textureLod(tex, coord, 0.0);
    return (pc.flags & 1u) != 0u ? c.bgra : c;
}

#define SMAA_RT_METRICS pc.rt_metrics
#define SMAA_PRESET_HIGH 1
#define SMAA_CUSTOM_SL 1
#define SMAATexture2D(tex) sampler2D tex
#define SMAATexturePass2D(tex) tex
#define SMAASampleLevelZero(tex, coord) textureLod(tex, coord, 0.0)
#define SMAASampleLevelZeroPoint(tex, coord) textureLod(tex, coord, 0.0)
#define SMAASampleLevelZeroOffset(tex, coord, offset) textureLodOffset(tex, coord, 0.0, offset)
#define SMAASample(tex, coord) textureLod(tex, coord, 0.0)
#define SMAASamplePoint(tex, coord) SmaaPoint(tex, coord)
#define SMAASampleOffset(tex, coord, offset) textureLodOffset(tex, coord, 0.0, offset)
#define SMAAGather(tex, coord) textureGather(tex, coord)
#define SMAA_FLATTEN
#define SMAA_BRANCH
// Compute shaders cannot discard: "no edge" is an edge texel of zero (every texel is written).
#define SMAA_DISCARD return vec2(0.0, 0.0)
#define lerp(a, b, t) mix(a, b, t)
#define saturate(a) clamp(a, 0.0, 1.0)
#define mad(a, b, c) fma(a, b, c)
#define float2 vec2
#define float3 vec3
#define float4 vec4
#define int2 ivec2
#define int3 ivec3
#define int4 ivec4
#define bool2 bvec2
#define bool3 bvec3
#define bool4 bvec4

#include "smaa/SMAA.hlsl"

// Linear light -> sRGB encoding (the exact curve; the store rounds to 8 bits).
vec3 EncodeSrgb(vec3 c) {
    c = clamp(c, 0.0, 1.0);
    return mix(c * 12.92, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, step(vec3(0.0031308), c));
}

#if defined(SMAA_WEIGHTS) && defined(SMAA_COMPACT)
// The blending weights with the pixels that have an edge packed together (FAST_GPU_SMAA_TRIM=2).
// In the 8x8 pass below every pixel is a thread and only a few percent of the pixels have an edge:
// a warp with one edge pixel runs the whole search for it while its other lanes idle. Here a 16x16
// tile first sorts its pixels: without an edge, weight 0 is stored at once (what
// SMAABlendingWeightCalculationPS returns when e.g and e.r are both 0: neither of its branches is
// taken and it returns its zero-initialised weights); with an edge, the pixel's local index is
// appended to a list in shared memory. Then the first n threads of the tile (n = the list's
// length: the first ceil(n / 32) warps) each run the 8x8 pass's per-pixel code for one listed
// pixel; the other warps are done. Every in-range texel is written exactly once, by the same
// arithmetic on the same inputs (texcoord from the pixel position; SMAABlendingWeightCalculationVS
// and PS; explicit-LOD fetches only: no derivatives, no subgroup operations, nothing that depends
// on the invocation that runs it): only which thread computes a pixel changes. The list's order
// (atomicAdd) varies from run to run; the texels do not. FAST_GPU_SMAA_TRIM_VERIFY checks the
// result against the 8x8 pass, since a driver may still compile the same expressions differently
// in another shader (fused multiply-adds).
shared uint s_count;
shared uint s_list[256];

void main() {
    const uint lid = gl_LocalInvocationIndex;
    if (lid == 0u) {
        s_count = 0u;
    }
    memoryBarrierShared();
    barrier();
    const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    // No early return: every invocation of the group has to reach both barrier() calls.
    if (p.x < pc.size.x && p.y < pc.size.y) {
        const vec2 texcoord = (vec2(p) + 0.5) * pc.rt_metrics.xy;
        // The fetch SMAABlendingWeightCalculationPS starts with, and its two branch conditions.
        const vec2 e = SMAASample(edges_tex, texcoord).rg;
        if (e.g > 0.0 || e.r > 0.0) {
            s_list[atomicAdd(s_count, 1u)] = lid;
        } else {
            imageStore(out_img, p, vec4(0.0));
        }
    }
    memoryBarrierShared();
    barrier();
    if (lid < s_count) {
        const uint s = s_list[lid];
        const ivec2 q = ivec2(gl_WorkGroupID.xy * 16u + uvec2(s & 15u, s >> 4u));
        // The 8x8 pass's SMAA_WEIGHTS code, for pixel q.
        const vec2 texcoord = (vec2(q) + 0.5) * pc.rt_metrics.xy;
        vec2 pixcoord;
        vec4 offset[3];
        SMAABlendingWeightCalculationVS(texcoord, pixcoord, offset);
        const vec4 w = SMAABlendingWeightCalculationPS(texcoord, pixcoord, offset, edges_tex,
                                                       area_tex, search_tex, vec4(0.0));
        imageStore(out_img, q, w);
    }
}
#else
void main() {
    const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= pc.size.x || p.y >= pc.size.y) {
        return;
    }
    const vec2 texcoord = (vec2(p) + 0.5) * pc.rt_metrics.xy;
#if defined(SMAA_EDGES)
    vec4 offset[3];
    SMAAEdgeDetectionVS(texcoord, offset);
    const vec2 e = SMAALumaEdgeDetectionPS(texcoord, offset, color_unorm);
    imageStore(out_img, p, vec4(e, 0.0, 0.0));
#elif defined(SMAA_WEIGHTS)
    vec2 pixcoord;
    vec4 offset[3];
    SMAABlendingWeightCalculationVS(texcoord, pixcoord, offset);
    const vec4 w = SMAABlendingWeightCalculationPS(texcoord, pixcoord, offset, edges_tex, area_tex,
                                                   search_tex, vec4(0.0));
    imageStore(out_img, p, w);
#elif defined(SMAA_BLEND)
    vec4 offset;
    SMAANeighborhoodBlendingVS(texcoord, offset);
    // The same test as SMAANeighborhoodBlendingPS: no weight -> the pixel exactly as it was.
    vec4 a;
    a.x = textureLod(blend_tex, offset.xy, 0.0).a; // Right
    a.y = textureLod(blend_tex, offset.zw, 0.0).g; // Top
    a.wz = textureLod(blend_tex, texcoord, 0.0).xz; // Bottom / Left
    if (dot(a, vec4(1.0)) < 1e-5) {
#ifndef SMAA_KEEP
        imageStore(out_img, p, texelFetch(color_unorm, p, 0));
#endif
        // SMAA_KEEP (FAST_GPU_SMAA_TRIM=1): no fetch, no store; A keeps the bytes it has, which
        // are B's only where the game's copy of A into B was exact (vr_smaa.cpp).
        return;
    }
    const vec4 c = SMAANeighborhoodBlendingPS(texcoord, offset, color_srgb, blend_tex);
    imageStore(out_img, p, vec4(EncodeSrgb(c.rgb), c.a));
#endif
}
#endif // SMAA_WEIGHTS && SMAA_COMPACT / the 8x8 passes

#include "winresrc.h"

#define xstr(s) str(s)
#define str(s) #s

// NEUTRAL LANG
LANGUAGE LANG_NEUTRAL, 0x8

// ICON
IDI_ICON1 ICON "shadps4.ico"

// VERSION
VS_VERSION_INFO VERSIONINFO
 FILEVERSION    EMULATOR_VERSION_MAJOR, EMULATOR_VERSION_MINOR, EMULATOR_VERSION_PATCH, 0
 PRODUCTVERSION EMULATOR_VERSION_MAJOR, EMULATOR_VERSION_MINOR, EMULATOR_VERSION_PATCH, 0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "\0"
            VALUE "FileDescription", "Bldbrne-VR runtime, based on shadPS4\0"
            VALUE "FileVersion", xstr(EMULATOR_VERSION_MAJOR) "." xstr(EMULATOR_VERSION_MINOR) "." xstr(EMULATOR_VERSION_PATCH) ".0\0"
            VALUE "InternalName", "shadPS4\0"
            VALUE "LegalCopyright", "Copyright 2025 shadPS4 Team (GPL-2.0-or-later); Copyright 2026 BB-VR contributors (AGPL-3.0-or-later)\0"
            VALUE "Comments", "Bldbrne-VR: https://github.com/bldbrne-vr/bldbrne-vr. Licensed GPL-3.0-or-later with AGPL-3.0-or-later terms for the Bldbrne-VR code. Redistribution is permitted only with these notices and the complete corresponding source.\0"
            VALUE "OriginalFilename", "shadPS4.exe\0"
            VALUE "ProductName", "Bldbrne-VR\0"
            VALUE "ProductVersion", xstr(EMULATOR_VERSION_MAJOR) "." xstr(EMULATOR_VERSION_MINOR) "." xstr(EMULATOR_VERSION_PATCH) ".0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
